# Copy to .env (git-ignored). Scripts load it with pipeline.config.load_env(); values are never printed.
DISCORD_BOT_TOKEN=            # from the Discord Developer Portal (already used by C:\Users\<user>\claude-discord-bot)
DISCORD_WEBHOOK_URL=          # a webhook for the #digest channel of the private CareerOS server
DISCORD_APPROVALS_CHANNEL_ID= # channel where approve/reject replies are read by the bot
DISCORD_OWNER_ID=             # your Discord user id; app/discord-bot ignores commands from anyone else
ADZUNA_APP_ID=                # https://developer.adzuna.com (free; 250 requests a day)
ADZUNA_APP_KEY=
REED_API_KEY=                 # https://www.reed.co.uk/developers/jobseeker (free)
CAREEROS_LOCAL_DIR=           # optional override of %USERPROFILE%\CareerOS-data
GMAIL_OAUTH_CLIENT_PATH=      # absolute path to Google desktop-client JSON; keep it outside this repository
